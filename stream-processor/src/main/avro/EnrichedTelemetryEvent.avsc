{
  "type": "record",
  "name": "EnrichedTelemetryEvent",
  "namespace": "com.aerostream.avro",
  "doc": "TelemetryEvent enriched with circuit and driver reference data from PostgreSQL via Debezium CDC",
  "fields": [
    {"name": "car_id",         "type": "string"},
    {"name": "driver_id",      "type": "string"},
    {"name": "session_id",     "type": "string"},
    {"name": "timestamp_ms",   "type": "long"},
    {"name": "lap",            "type": "int"},
    {"name": "sector",         "type": "int"},
    {"name": "speed_kph",      "type": "double"},
    {"name": "rpm",            "type": "int"},
    {"name": "gear",           "type": "int"},
    {"name": "throttle_pct",   "type": "double"},
    {"name": "brake_pct",      "type": "double"},
    {"name": "drs_active",     "type": "boolean"},
    {"name": "tire_compound",  "type": "com.aerostream.avro.TireCompound"},
    {"name": "tire_temp_fl",   "type": "double"},
    {"name": "tire_temp_fr",   "type": "double"},
    {"name": "tire_temp_rl",   "type": "double"},
    {"name": "tire_temp_rr",   "type": "double"},
    {"name": "tire_wear_fl",   "type": "double"},
    {"name": "tire_wear_fr",   "type": "double"},
    {"name": "tire_wear_rl",   "type": "double"},
    {"name": "tire_wear_rr",   "type": "double"},
    {"name": "fuel_load_kg",   "type": "double"},
    {"name": "engine_temp_c",  "type": "double"},
    {"name": "ers_deploy_pct", "type": "double"},
    {"name": "g_force_lat",    "type": "double"},
    {"name": "g_force_lon",    "type": "double"},
    {"name": "circuit_name",       "type": ["null", "string"],  "default": null, "doc": "From Debezium CDC — circuits.circuit_name"},
    {"name": "circuit_country",    "type": ["null", "string"],  "default": null, "doc": "From Debezium CDC — circuits.country"},
    {"name": "circuit_length_km",  "type": ["null", "double"],  "default": null, "doc": "From Debezium CDC — circuits.length_km"},
    {"name": "num_laps",           "type": ["null", "int"],     "default": null, "doc": "From Debezium CDC — circuits.num_laps"},
    {"name": "drs_zones",          "type": ["null", "int"],     "default": null, "doc": "From Debezium CDC — circuits.drs_zones"},
    {"name": "pit_loss_time_s",    "type": ["null", "double"],  "default": null, "doc": "From Debezium CDC — circuits.pit_loss_time_s"},
    {"name": "driver_full_name",   "type": ["null", "string"],  "default": null, "doc": "From Debezium CDC — drivers.full_name"},
    {"name": "driver_abbrev",      "type": ["null", "string"],  "default": null, "doc": "From Debezium CDC — drivers.abbreviated_name"},
    {"name": "driver_team",        "type": ["null", "string"],  "default": null, "doc": "From Debezium CDC — drivers.team_id"},
    {"name": "driver_nationality", "type": ["null", "string"],  "default": null, "doc": "From Debezium CDC — drivers.nationality"},
    {"name": "enrichment_ts_ms",   "type": "long",    "default": 0,     "doc": "Wall-clock timestamp when enrichment was applied"},
    {"name": "enriched",           "type": "boolean", "default": false, "doc": "True when both circuit AND driver lookup succeeded"}
  ]
}
