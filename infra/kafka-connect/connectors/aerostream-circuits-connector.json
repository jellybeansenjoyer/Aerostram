{
  "name": "aerostream-circuits-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "aerostream",
    "database.password": "",
    "database.dbname": "aerostream",
    "topic.prefix": "aerostream",
    "table.include.list": "public.circuits",
    "plugin.name": "pgoutput",
    "publication.autocreate.mode": "filtered",
    "publication.name": "aerostream_circuits_pub",
    "slot.name": "aerostream_circuits_slot",
    "snapshot.mode": "initial",
    "heartbeat.interval.ms": "0",
    "transforms": "unwrap,route,extractKey",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": "false",
    "transforms.unwrap.handle.deletes": "rewrite",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "aerostream\\.public\\.circuits",
    "transforms.route.replacement": "circuit-metadata",
    "transforms.extractKey.type": "org.apache.kafka.connect.transforms.ExtractField$Key",
    "transforms.extractKey.field": "circuit_id",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "http://schema-registry:8081",
    "value.converter.schemas.enable": "true"
  }
}
