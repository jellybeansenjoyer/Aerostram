{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.4.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "AeroStream Telemetry Producer — events/sec, DLQ rate, active cars, Kafka producer latency",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Events Published / sec",
      "type": "timeseries",
      "description": "rate(telemetry_events_published_total[1m]) — live publishing throughput",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } },
      "targets": [
        {
          "expr": "rate(telemetry_events_published_total{service=\"producer\"}[1m])",
          "legendFormat": "events/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "DLQ Rate / sec",
      "type": "timeseries",
      "description": "rate(telemetry_events_dlq_total[1m]) — events routed to dead letter queue",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "unit": "reqps"
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } },
      "targets": [
        {
          "expr": "rate(telemetry_events_dlq_total{service=\"producer\"}[1m])",
          "legendFormat": "dlq/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Active Cars",
      "type": "stat",
      "description": "telemetry_active_cars — number of cars currently being simulated",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 20 }
            ]
          },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto" },
      "targets": [
        {
          "expr": "telemetry_active_cars",
          "legendFormat": "active cars",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total Events Published",
      "type": "stat",
      "description": "telemetry_events_published_total — cumulative count since last start",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 }
            ]
          },
          "unit": "short",
          "decimals": 0
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto" },
      "targets": [
        {
          "expr": "telemetry_events_published_total{service=\"producer\"}",
          "legendFormat": "total published",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Total DLQ Events",
      "type": "stat",
      "description": "telemetry_events_dlq_total — cumulative DLQ route count",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "unit": "short",
          "decimals": 0
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "telemetry_events_dlq_total{service=\"producer\"}",
          "legendFormat": "total dlq",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Kafka Producer Record Send Rate",
      "type": "timeseries",
      "description": "rate(kafka_producer_record_send_total[1m]) — raw Kafka producer send rate from JMX",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1.5 },
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "expr": "rate(kafka_producer_record_send_total[1m])",
          "legendFormat": "{{client_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Producer Request Latency (avg)",
      "type": "timeseries",
      "description": "kafka_producer_request_latency_avg — average round-trip time to broker",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1.5 },
          "unit": "ms"
        }
      },
      "targets": [
        {
          "expr": "kafka_producer_request_latency_avg",
          "legendFormat": "{{client_id}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["aerostream", "producer", "kafka", "phase-2"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "AeroStream — Producer",
  "uid": "aerostream-producer",
  "version": 1
}
