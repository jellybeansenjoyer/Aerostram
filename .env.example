# ──────────────────────────────────────────────────────────────────────────────
# AeroStream — Environment Configuration Template
# Copy to .env and fill in real values before running: cp .env.example .env
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────────────────────────

# Kafka Cluster — generate CLUSTER_ID with:
#   docker run --rm confluentinc/cp-kafka:7.6.1 kafka-storage random-uuid
# Or run: bash infra/scripts/init-kafka-storage.sh
KAFKA_CLUSTER_ID=

# Kafka broker external ports (internal always 9092)
KAFKA_BROKER_1_EXTERNAL_PORT=9092
KAFKA_BROKER_2_EXTERNAL_PORT=9094
KAFKA_BROKER_3_EXTERNAL_PORT=9096

# Schema Registry
SCHEMA_REGISTRY_PORT=8081

# Kafka UI (Provectus)
KAFKA_UI_PORT=8080

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# PostgreSQL (Phase 3 — CDC)
POSTGRES_PORT=5432
POSTGRES_DB=aerostream
POSTGRES_USER=aerostream
POSTGRES_PASSWORD=changeme_in_production

# ── Phase 2 ──────────────────────────────────────────────────────────────────
# SIMULATOR_CARS=20
# SIMULATOR_RATE_HZ=10

# ── Phase 5 ──────────────────────────────────────────────────────────────────
# ML_CONSUMER_PORT=8099
# PIT_THRESHOLD=0.65
# CONSUMER_SLOWDOWN_MS=0
